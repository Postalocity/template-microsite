{
  "name": "@microsite/engine",
  "version": "0.1.0",
  "description": "Core engine utilities for the Microsite Platform (config loading, IKB, etc.)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./config-loader": {
      "types": "./dist/src/config-loader.d.ts",
      "import": "./dist/src/config-loader.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@microsite/types": "file:../types"
  }
}