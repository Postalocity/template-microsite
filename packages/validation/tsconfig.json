{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmitOnError": false,
    "composite": false
  },
  "include": [
    "src/**/*",
    "../common/types/engine.ts",
    "../common/types/content.ts",
    "../../engine/config-loader.ts",
    "../../engine/index.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
