{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@microsite/types": ["../types/src"],
      "@microsite/types/*": ["../types/src/*"],
      "@microsite/engine": ["../engine/src"],
      "@microsite/engine/*": ["../engine/src/*"]
    }
  },
  "references": [
    { "path": "../types" },
    { "path": "../engine" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
