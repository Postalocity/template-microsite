{
  "name": "@microsite/validation",
  "version": "0.1.0",
  "description": "Pure, framework-agnostic IKB compliance validation and content quality checks for use by headless CMS (Payload/Strapi) and the generator.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./ikb-validator": {
      "types": "./dist/src/ikb-validator.d.ts",
      "import": "./dist/src/ikb-validator.js"
    },
    "./content-quality": {
      "types": "./dist/src/content-quality.d.ts",
      "import": "./dist/src/content-quality.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'add eslint later'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@microsite/types": "file:../types",
    "@microsite/engine": "file:../engine"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "zod": "^3.24.1"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/htafolla/template-microsite.git",
    "directory": "packages/validation"
  },
  "license": "MIT"
}
